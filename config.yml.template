# Blog AutoPost CLI 設定ファイルテンプレート
# このファイルを config.yml にコピーして、自分の環境に合わせて編集してください

# ========================================
# 基本設定
# ========================================

announcement_text: "ブログを更新しました！"

blog:
  - name: "main"
    feed_url: "https://example.com/blog/index.xml"
    image_settings:
      default_image: "https://example.com/assets/default-card.png"
      enable_link_cards: true
      image_strategy:
        - "featured_image"
        - "first_content_image"
        - "og_image"
        - "default"
      image_filters:
        exclude_domains:
          - "affiliate.example.com"
          - "ads.example.com"
        min_width: 200
        min_height: 200
  - name: "youtube"
    feed_url: "https://www.youtube.com/feeds/videos.xml?channel_id=YOUR_CHANNEL_ID"
    image_settings:
      default_image: null
      enable_link_cards: true
      image_strategy:
        - "featured_image"
        - "og_image"
        - "default"
      image_filters:
        min_width: 200
        min_height: 200

# ========================================
# SNS設定（配列形式で複数アカウントを指定可能）
# ========================================

sns:
  - type: x
    name: "x-main"
    consumer_key: "<X_CONSUMER_KEY>"
    consumer_secret: "<X_CONSUMER_SECRET>"
    access_token: "<X_ACCESS_TOKEN>"
    access_token_secret: "<X_ACCESS_TOKEN_SECRET>"
  - type: bluesky
    name: "bluesky-main"
    identifier: "<BLUESKY_HANDLE>"
    password: "<BLUESKY_APP_PASSWORD>"
  - type: mastodon
    name: "mastodon-main"
    instance_url: "https://mastodon.example"
    access_token: "<MASTODON_ACCESS_TOKEN>"
  - type: misskey
    name: "misskey-main"
    instance_url: "https://misskey.example"
    access_token: "<MISSKEY_ACCESS_TOKEN>"
    is_sensitive: false
  # Threads と Tumblr は設定を書けますが、Rust 版には投稿クライアントの
  # 実装がありません (移植対象外)。設定しても投稿はスキップされます。
  # MCP の sns 引数で名指しした場合は未対応であるとエラーが返ります。
  #
  # - type: threads
  #   name: "threads-main"
  #   user_id: "<THREADS_USER_ID>"
  #   access_token: "<THREADS_ACCESS_TOKEN>"
  # - type: tumblr
  #   name: "tumblr-main"
  #   consumer_key: "<TUMBLR_CONSUMER_KEY>"
  #   consumer_secret: "<TUMBLR_CONSUMER_SECRET>"
  #   oauth_token: "<TUMBLR_OAUTH_TOKEN>"
  #   oauth_secret: "<TUMBLR_OAUTH_SECRET>"
  #   blog_identifier: "<TUMBLR_BLOG_IDENTIFIER>"

# ========================================
# Web UI 認証・セッション設定
# ========================================

web_auth:
  username: "admin"
  password: "changeme"
  secret_key: "<WEB_SESSION_SECRET>"

  # 以下は省略可能。書かなければ既定値で動作する。

  # ログインセッションの有効期間 (時間)。既定は 24。
  # session_ttl_hours: 24

  # セッション Cookie に Secure 属性を付ける方針。
  #   auto   : HTTPS 由来と判定できたときだけ付ける (既定)
  #   always : 常に付ける。TLS 終端が確実な環境向け
  #   never  : 付けない
  # auto はリバースプロキシの X-Forwarded-Proto を見るため、
  # 素の HTTP で運用していてもログインできなくならない。
  # cookie_secure: "auto"

  # ログイン試行のレート制限。窓内に許す失敗回数と窓の長さ (秒)。
  # 既定は 5 回 / 300 秒。超えると 429 を返す。
  # login_max_attempts: 5
  # login_window_seconds: 300

# ========================================
# MCP サーバ設定
# ========================================
#
# この節ごと省略できる。省略した場合は web_auth.secret_key で
# MCP を認証する (従来どおりの動作)。
#
# api_key を設定すると secret_key では MCP を認証できなくなり、
# キーが漏れたときの影響範囲を MCP だけに限定できる。
#
# キーの生成例:
#   openssl rand -hex 32
#
# mcp:
#   # MCP エンドポイントを有効にするか。既定は true。
#   # false にすると /api/mcp/* は常に 401 を返す。
#   enabled: true
#
#   # MCP 専用の API キー。web_auth.secret_key とは別の値にする。
#   api_key: "<MCP_API_KEY>"
#
#   # 移行期間だけ web_auth.secret_key も受け付けたい場合に true。
#   # 既定は false で、api_key のみを受け付ける。
#   allow_web_secret_key: false
#
#   # MCP の tool がメディアとして参照できるディレクトリ。
#   # 未指定時は data/uploads と data のみを許可する。
#   # ここに書いたディレクトリの外にあるファイルは添付できない。
#   allowed_media_dirs:
#     - "data/uploads"
#     - "data"
#
#   # Origin ヘッダを付けたリクエストを受け付けるオリジン。
#   # MCP クライアント (Claude Code や Codex) は Origin を送らないため、
#   # 通常は設定不要。ブラウザから直接叩く場合だけ列挙する。
#   # 未設定時は Origin 付きのリクエストを拒否する (DNS リバインディング対策)。
#   allowed_origins:
#     - "https://ui.example.com"

# 以下の web: と web_server: は Python 版の設定であり、Rust 版は読み込みません。
# 残しておいても無害ですが、設定しても効果はありません。
#
# 待ち受けポートは起動時のオプションで指定します。
#   cargo run -- serve --port 8080
#   just run-web
#
# web:
#   session:
#     secret_key: "<WEB_SESSION_SECRET>"
#
# web_server:
#   host: "0.0.0.0"
#   port: 8000

# ========================================
# 予約投稿と投稿タイミングの設定
# ========================================

scheduled_posts:
  completed_retention_hours: 12.0  # 投稿済みジョブを保持する時間（時間単位）

default_allowed_timings:
  - ["*", ["09:00", "12:00", "18:00"]]
  - ["Weekday", ["07:30", "20:00"]]
  - ["Weekend", ["10:00", "21:00"]]

allowed_timings_tolerance_minutes: 5

allowed_timings:
  x-main:
    - ["Weekday", ["08:00", "12:00", "17:00", "21:00"]]
  bluesky-main:
    - ["*", ["07:30", "13:30", "19:30"]]
  mastodon-main:
    - ["*", ["06:00", "14:00", "22:00"]]

# ========================================
# CLI補助設定
# ========================================

cli:
  default_just_target: "blog-check"

# ========================================
# テンプレートサンプル
# ========================================

templates:
  default: "{title} {link}"
  mastodon: "{title}\n{link}\n\n{summary}"
  slack: "*{title}*\n{link}"

